{
  "name": "nordic-conf-pw",
  "version": "1.0.0",
  "description": "Playwright TypeScript workshop project for Nordic Conference",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen https://demo.playwright.dev/todomvc",
    "skills:sync": "rsync -a --delete .roo/skills/ .clinerules/skills/",
    "skills:check": "diff -r .roo/skills .clinerules/skills && echo 'skills in sync'",
    "cline:setup": "node scripts/cline-setup.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "e2e"
  ],
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
